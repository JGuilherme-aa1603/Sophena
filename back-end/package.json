{
  "name": "sophena-api",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "create:admin-user": "tsx scripts/create-admin-user.ts",
    "hash:password": "tsx scripts/hash-password-from-env.ts",
    "reset:user-password": "tsx scripts/reset-user-password.ts",
    "build": "yarn && prisma generate && tsc --noEmit",
    "start": "tsx src/server.ts",
    "test": "tsx --import ./tests/integration/support/test-env.ts --test --test-concurrency=1 tests/unit/**/*.test.ts tests/integration/**/*.test.ts",
    "test:auth": "tsx --import ./tests/integration/support/test-env.ts --test --test-concurrency=1 tests/integration/auth/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
